# Local configuration template. Never put real credentials in source control.
KAGGLE_USERNAME=your_kaggle_username
KAGGLE_KEY=replace_with_kaggle_api_key
KAGGLE_BRIDGE_DATA_DIR=./data
MCP_TRANSPORT=stdio

# Required only for cloud HTTP mode; generate a random secret of at least 32 chars.
MCP_AUTH_TOKEN=replace_with_long_random_secret
